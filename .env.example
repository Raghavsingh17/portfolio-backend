# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (Allowed origins for CORS)
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (Atlas URI or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_db

# Email Service Configuration (Nodemailer with Gmail or Custom SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
# For Gmail, use an "App Password" generated in your Google Account Security settings
EMAIL_PASS=your-16-character-app-password
EMAIL_RECEIVER=your-personal-email@gmail.com

# Google Gemini API Key (For Raghav's AI Chatbot Assistant)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=GEMINI_API_KEY
